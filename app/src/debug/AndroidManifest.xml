<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <service android:name=".qualification.FixtureTaskService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started bounded engineering check of an offline fixture on a private display, with a visible Stop notification. Direct-development APK only." />
        </service>
        <activity android:name=".qualification.PhoneQualificationActivity" android:exported="false" />
        <activity android:name=".qualification.BrowserFixtureActivity" android:exported="false" />
        <provider android:name=".qualification.DocumentFixtureProvider" android:authorities="${applicationId}.documents-fixture" android:exported="false" />
        <service android:name=".qualification.LeaseOwnerService" android:exported="false" android:process=":leaseOwnerFixture" />
    </application>
</manifest>
